__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
*.egg-info/
dist/
build/
.idea/
.vscode/
*.log
node_modules/
frontend/dist/
.runtime/

# Copied research artifacts are never shared between BTC and ETH.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.csv
!data/.gitkeep

# Database files (regenerated at runtime)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.db.bak
backend/data/*.json.bak
backend/data/*.malformed.db
backend/data/deribit_instruments_cache.json
backend/data/deribit_instruments_cache.json.tmp
!backend/data/.gitkeep

# Consistent MOS dataset archives (generated by MOS Dataset Exporter)
backend/exports/
